<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Dsb" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ds_brand</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">@color/ds_brand_dark</item>
        <item name="colorSecondary">@color/ds_brand</item>
        <item name="android:colorBackground">@color/ds_bg</item>
        <item name="colorSurface">@color/ds_surface</item>
        <item name="colorOnSurface">@color/ds_text</item>
        <item name="colorSurfaceVariant">@color/ds_surface_alt</item>
        <item name="android:statusBarColor">@color/ds_bg</item>
        <item name="android:navigationBarColor">@color/ds_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">@color/ds_text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="CardValue">
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardValueSmall">
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textColor">@color/ds_text_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="WidgetText">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WidgetValue">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetValueSmall">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
